+            SET name = ?, work = ?, category = ?, admin_email = ?, document_number = ?, email = ?, phone = ?, hire_date = ?, salary = ?, notes = ?
+            WHERE id = ?';
+
+    $stmt = $conn->prepare($sql);
+    if (!$stmt) {
+        return false;
+    }
+
+    $stmt->bind_param(
+        'ssssssssssi',
+        $data['name'],
+        $data['work'],
+        $data['category'],
+        $data['admin_email'],
+        $data['document_number'],
+        $data['email'],
+        $data['phone'],
+        $data['hire_date'],
+        $data['salary'],
+        $data['notes'],
+        $id
+    );
+
+    $ok = $stmt->execute();
+    $stmt->close();
+    return $ok;
+}
